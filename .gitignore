# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets
.env

# Data — publish the final outputs + the small OSM source cache so the repo is
# self-contained and shareable. Exclude only the bulky, re-downloadable TIGER
# shapefile (~80 MB, auto-fetched by the pipeline) and interim build files.
data/raw/tiger/
data/interim/**
!data/interim/.gitkeep

# OS
.DS_Store

# Multi-hazard layers from Dennies Bor (Zenodo 10.5281/zenodo.20331026, ~929MB, not redistributed here)
data/hazards/

# Cached ArcGIS responses for building/flood attributes (regenerable)
data/raw/buildings/

data/hazards/water/

# Manuscript draft. Kept local and shared directly with co-authors rather than
# published in the repo, so an unfinished draft is not public.
/paper/

# Large regenerable index downloads. Both are fetched by their own scripts and
# are far too big to version: the TEMPO tile index is ~369 MB and the 3DEP EPT
# boundary file ~8 MB. The small per-facility result caches they produce ARE
# tracked, since those are the expensive part to recreate.
data/raw/tempo/tile_index.gpkg
data/raw/lidar/3dep_ept_boundaries.geojson
